# Optional OpenAI-compatible provider. Configure all three values to enable generate_with_ai.
# Example base URL: https://api.example.com/v1
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT_SECONDS=45
AI_MAX_ATTEMPTS=3
AI_RETRY_BACKOFF_SECONDS=0.5

# Local SQLite database path
MEHR_DB_PATH=mehr_ai_studio.sqlite3

# Optional standards-based OIDC resource-server integration.
# Copy the exact issuer and JWKS endpoint from your identity provider metadata.
# All endpoints must use HTTPS. Audience is the API audience configured at the IdP.
MEHR_OIDC_ISSUER_URL=
MEHR_OIDC_JWKS_URL=
MEHR_OIDC_AUDIENCE=
# Exact public MCP endpoint URL, e.g. https://studio.example.com/mcp
MEHR_MCP_RESOURCE_URL=
MEHR_OIDC_REQUIRED_SCOPES=studio:access
MEHR_OIDC_TENANT_CLAIM=tenant_id

# Cloudflare Worker secrets/vars for direct MEHR Live Realtime WebRTC.
# Set OPENAI_API_KEY as a Worker secret; never expose it in browser code or Git.
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
OPENAI_REALTIME_VOICE=marin

# Worker-side OIDC resource-server validation (configure from your identity provider).
OIDC_ISSUER_URL=
OIDC_JWKS_URL=
OIDC_AUDIENCE=
OIDC_CLIENT_ID=
OIDC_REQUIRED_SCOPES=studio:access
OIDC_TENANT_CLAIM=tenant_id
