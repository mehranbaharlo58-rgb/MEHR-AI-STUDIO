# Optional OpenAI-compatible provider for the Python package.
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT_SECONDS=45
AI_MAX_ATTEMPTS=3
AI_RETRY_BACKOFF_SECONDS=0.5

# Local SQLite database path
MEHR_DB_PATH=mehr_ai_studio.sqlite3

# Optional standards-based OIDC integration for the Python MCP resource server.
MEHR_OIDC_ISSUER_URL=
MEHR_OIDC_JWKS_URL=
MEHR_OIDC_AUDIENCE=
MEHR_MCP_RESOURCE_URL=
MEHR_OIDC_REQUIRED_SCOPES=studio:access
MEHR_OIDC_TENANT_CLAIM=tenant_id

# MEHR Live Cloudflare Worker runtime configuration.
# The deploy workflow maps matching GitHub Actions secrets into Worker secrets.
# Never commit actual values here.
OIDC_ISSUER_URL=
OIDC_JWKS_URL=
OIDC_AUDIENCE=
OIDC_CLIENT_ID=
OIDC_AUTHORIZATION_URL=
OIDC_TOKEN_URL=
# Exact GitHub Pages callback, including repository path and trailing slash.
OIDC_REDIRECT_URI=https://mehranbaharlo58-rgb.github.io/MEHR-AI-STUDIO/
OIDC_PUBLIC_SCOPES=openid profile studio:access
OIDC_REQUIRED_SCOPES=studio:access
OIDC_TENANT_CLAIM=tenant_id

# Direct OpenAI Realtime voice and sampled-image vision.
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
OPENAI_REALTIME_VOICE=marin

# Optional Cloudflare Realtime SFU relay. Supply both values or neither.
# Direct WebRTC voice and sampled-image vision do not require these SFU values.
CLOUDFLARE_SFU_APP_ID=
CLOUDFLARE_SFU_APP_SECRET=

# Cloudflare deployment credentials (GitHub Actions only; never Worker secrets).
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Local-first M1 Ollama gateway. Keep the listener on loopback.
MEHR_OLLAMA_URL=http://127.0.0.1:11434
MEHR_OLLAMA_TIMEOUT=120
MEHR_GATEWAY_API_KEY=replace-with-a-long-random-local-secret
MEHR_GATEWAY_HOST=127.0.0.1
MEHR_GATEWAY_PORT=8080
